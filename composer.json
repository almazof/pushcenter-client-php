{
    "name": "pushcenter/client",
    "description": "PushCenter thin PHP client: device registry + notification enqueue over the v1 gateway contract",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0"
    },
    "suggest": {
        "ext-curl": "Required by the built-in CurlTransport (projects without a PSR-18 client)"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PushCenter\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PushCenter\\Client\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
